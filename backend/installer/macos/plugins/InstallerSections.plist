<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Section order for Installer.app. The built-in section names are fixed; a
  custom section is referenced by its bundle FILE NAME (with the .bundle
  extension), NOT by its InstallerSectionTitle. The sidebar label shown for it
  comes from InstallerSectionTitle in the bundle's Info.plist ("Internet").
  This file sits alongside the .bundle in the productbuild plugins directory.

  MoonlightWebInstaller.bundle is left out of the order while Internet Access is
  switched off (backend/src/common/Edition.h): its pane is the Internet-link
  opt-in. Without it the postinstall takes its documented defaults, Internet
  off and start at login on, exactly as an `installer` CLI run does; the app's
  setup wizard still offers the login item. Put it back after PackageSelection
  once a release has trusted servers to offer Internet Access again.
-->
<plist version="1.0">
<dict>
    <key>SectionOrder</key>
    <array>
        <string>Introduction</string>
        <string>ReadMe</string>
        <string>License</string>
        <string>Target</string>
        <string>PackageSelection</string>
        <string>Install</string>
        <string>FinishUp</string>
    </array>
</dict>
</plist>
